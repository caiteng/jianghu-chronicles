# Jianghu Chronicles server deployment environment.
# Copy this file to .env.server before deploying and adjust values if needed.

# Public HTTP port exposed by the frontend container.
# Use 80 for direct http://SERVER_IP access.
PUBLIC_HTTP_PORT=80

# Frontend runtime mode for config.js.
REACT_APP_ENV=Production

# Max concurrent player connections accepted by game-service.
MAX_CONNECTIONS=100

# Runtime log levels.
FLECK_LOG=Info
IM_LOG=Info
GAME_LOG=Info

# Current game-service configuration source used by the playable prototype.
CONFIG_SOURCE=v2.0
