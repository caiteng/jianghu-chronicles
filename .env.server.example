# Public HTTP port on your cloud server.
# Use 80 for direct http://SERVER_IP access.
# Use 8080 if port 80 is occupied or blocked.
PUBLIC_HTTP_PORT=80

# Frontend runtime mode used by the original app config.js.
REACT_APP_ENV=Development

# Max concurrent player connections accepted by game-service.
MAX_CONNECTIONS=100

# Log levels.
FLECK_LOG=Info
IM_LOG=Info
GAME_LOG=Info

# Original project config source.
CONFIG_SOURCE=v2.0
